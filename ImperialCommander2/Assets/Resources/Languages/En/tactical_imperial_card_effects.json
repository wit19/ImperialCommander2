 "conventions": {
  "buckets": {
   "a": "planer-modifier: hook lands on the activation-order / target strength pipeline (OrderPlanner)",
   "b": "stat-modifier: hook lands on an existing value seam (threat engagement, deployment economy) or a store-model seam (attachment lifecycle, effective Health)",
   "c": "engine-detail: real rules work needed (dice manipulation, token/condition operations, spatial legality). ACTIVE in the game, WITHOUT an AI model - shown honestly in the M12e UI."
  },
  "determinism": "hooks only modify the existing assessment pipeline (no new RNG pot, no hidden information, printed floors only)",
  "sides": "effects belong to the side owning the card; the engine distinguishes faction only, never AI vs human hand"
 },
 "hooks": {
  "order_boost": {
   "consumed_by": "OrderPlanner.PlanRound(cardEffects) - Staerke-Effizienz stage",
   "unit": "stage",
   "values": [
    "5/4",
    "1/8"
   ],
   "law": "printes an extra action / extra activation cycle (5/4) or activation-timed movement points (1/8) to the owning side; applied MAX-once per group, public tag + why-text"
  },
  "atk_ev_bonus": {
   "consumed_by": "OrderPlanner.PlanRound(cardEffects) - printed strength",
   "unit": "rational damage EV",
   "values": [
    "1/12",
    "1/8",
    "1/4",
    "1/3",
    "2/3",
    "5/12",
    "3/4",
    "1",
    "3/2",
    "5/6"
   ],
   "law": "printed always-on attack-pool improvement, conservative floor (surge prints -> blue surge floor 1/3; a printed fixed '+1 {H}/{C} to the attack results' is the exact pip 1)"
  },
  "focus_surcharge": {
   "consumed_by": "OverlordFocus.Rank(cardEffects) - light +1 econ slot (M11d/M11h, MAX)",
   "unit": "stage",
   "values": [
    "1"
   ],
   "law": "printed targeting/attack-declare condition marks the conditioned hero as the cheaper finish (light, never a primary signal)"
  },
  "engage_acc_delta": {
   "consumed_by": "HeroThreatModelV2.Threat(engage) via OverlordFocus.Rank(engage)",
   "unit": "accuracy pips (signed)",
   "values": [
    "1",
    "-1"
   ],
   "law": "printed accuracy pips or attack/defense result shifts on the hero exchange; + = owning side's attacks hit harder (threat of the hero UP), - = hero attacks the owning side worse (threat DOWN); pip floor 1, never inflated"
  },
  "engage_pierce": {
   "consumed_by": "HeroThreatModelV2.Threat(engage) via OverlordFocus.Rank(engage)",
   "unit": "printed Pierce",
   "values": [
    "1"
   ],
   "law": "printed 'Pierce N' on attacks of the owning side"
  },
  "deploy_cost": {
   "consumed_by": "ThreatLedger.EffectiveCost (reserve release / anti-stall)",
   "unit": "threat reduction",
   "values": [
    "1",
    "5"
   ],
   "law": "printed deployment-cost reduction for a legal group, floored at 0"
  },
  "free_group": {
   "consumed_by": "ThreatLedger.EffectiveCost at 0 / bridge deploy option (M12e wiring)",
   "unit": "sentinel",
   "values": [
    "1"
   ],
   "law": "a group arrives without paying its deployment cost"
  },
  "attach_lifecycle": {
   "consumed_by": "Saga.ImperialDeckState attachment lifecycle (store model)",
   "unit": "sentinel",
   "values": [
    "1"
   ],
   "law": "RR 'Attachment': attach at deployment on the deploy card, acts on ALL figures of the group, returns when the last figure is defeated, re-attachable at future deployments (NOT consumed)"
  },
  "stat_health": {
   "consumed_by": "ImperialCardEffects.EffectiveVitality (bridge attrition input)",
   "unit": "Health",
   "values": [
